# Copy to `.env` for local development. NEVER commit the real .env (it is
# gitignored). On Cloud Run these values come from Secret Manager instead.

APP_ENV=development
PORT=8080

# AI / geocoding (Phase 3)
# Gemini API key from https://aistudio.google.com/apikey (format: AIza...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Places API key (enable "Places API (New)" in Google Cloud). Can be the same
# key as above if Places is enabled on it.
GOOGLE_PLACES_API_KEY=

# Firebase (ID-token verification)
FIREBASE_PROJECT_ID=surya-assistance
# DEV ONLY: set true to bypass token checks for local testing. Never in prod.
AUTH_DISABLED=false

# Langfuse tracing (optional; leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
